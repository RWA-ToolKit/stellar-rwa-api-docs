# All variables are optional. NEXT_PUBLIC_* values are inlined at build time.
# Full reference: "Environment variables" in the root README.md.

# Canonical site URL (metadataBase, sitemap.xml, robots.txt).
# Defaults to https://stellar-rwa-docs.vercel.app; set to your own domain when self-hosting.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the deployed Stellar RWA API (used in docs examples).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# API version for versioning banner (e.g., "v1.0.0", "v1.1.0").
# If not set, defaults to "v1.0.0".
NEXT_PUBLIC_API_VERSION=v1.0.0

# Version currently deployed; a newer value than NEXT_PUBLIC_API_VERSION shows
# the "docs may be out of date" banner. Defaults to NEXT_PUBLIC_API_VERSION.
# NEXT_PUBLIC_CONTRACT_VERSION=v1.0.0

# Only read by scripts/fetch-api-version.mjs to look up the deployed version.
# API_BASE_URL=http://localhost:8080
