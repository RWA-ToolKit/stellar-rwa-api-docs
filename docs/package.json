{
  "name": "stellar-rwa-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:mdx-samples": "node scripts/check-mdx-samples.mjs",
    "check:contract-ids": "node scripts/check-contract-ids.mjs",
    "check:headings": "node scripts/check-heading-hierarchy.mjs",
    "generate:types": "openapi-typescript public/openapi-v1.yaml -o types/api.d.ts",
    "check:types": "openapi-typescript public/openapi-v1.yaml --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.0",
    "next": "16.4.6",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.0",
    "jsdom": "^25.0.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^2.1.8",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}